# mock: 화면에서 가상 데이터로 동작 확인 (로그인 없이 바로 실행)
# live: Supabase에 실제로 적재된 센서 데이터를 조회/구독 + 회원가입/로그인 활성화
NEXT_PUBLIC_DATA_SOURCE=mock

# 이 두 값이 채워지는 순간부터 로그인/회원가입이 강제됩니다 (middleware.ts 참고)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 회원관리(등급 변경)·로그인 이력 조회에 필요 (서버 전용, 절대 NEXT_PUBLIC_ 접두어 붙이지 마세요)
# Supabase Project Settings > API Keys > Secret keys 에서 확인 (sb_secret_... 형태)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

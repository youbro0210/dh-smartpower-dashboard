# ============================================================================
#  MQTT 수집 서버 설정
#  이 파일을 .env 로 복사해서 값을 채웁니다.
#  DATABASE_URL 은 비워 두면 상위 폴더의 .env.local 값을 씁니다.
# ============================================================================

# 브로커 (같은 EC2 의 Mosquitto 를 쓰는 경우)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# 장비와 공용으로 쓰지 말고, 수집기 전용 계정을 따로 발급하세요.
MQTT_USER=
MQTT_PASS=

# 외부에서 붙는 장비가 있으면 TLS(8883)를 켭니다.
MQTT_TLS=false
# MQTT_CA=/etc/mosquitto/certs/ca.crt

MQTT_CLIENT_ID=dh-collector
MQTT_TOPIC_PREFIX=dh/v1

# DEBUG 로 두면 수신한 메시지가 모두 찍힙니다.
COLLECTOR_LOG_LEVEL=INFO

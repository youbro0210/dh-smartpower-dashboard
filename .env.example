# ============================================================================
#  DH 스마트파워 변압기 통합 모니터링 - 환경변수
#  이 파일을 .env.local 로 복사해서 값을 채웁니다.
#  주의: NEXT_PUBLIC_ 으로 시작하는 값은 빌드 시점에 번들에 박히므로,
#        값을 바꾸면 반드시 다시 빌드해야 합니다.
# ============================================================================

# PostgreSQL 접속 문자열
# 같은 EC2 인스턴스의 로컬 DB를 쓰는 경우의 예시입니다.
DATABASE_URL=postgres://dh:비밀번호@127.0.0.1:5432/dhsmartpower

# 외부 DB(RDS 등)로 옮길 때만 require 로 설정합니다.
# PGSSL=require

# 세션 쿠키 서명 키 (32자 이상 필수)
# 생성:  openssl rand -base64 48
# 이 값이 바뀌면 기존 로그인 세션이 모두 무효화됩니다.
AUTH_SECRET=

# HTTPS 로 서비스할 때 true. HTTP 로컬 개발에서는 false 여야 쿠키가 저장됩니다.
COOKIE_SECURE=true

# 커넥션 풀 크기 (기본 10)
# PGPOOL_MAX=10

# ---------------------------------------------------------------------------
# 챗봇 (선택)
# 설정하지 않으면 챗봇 버튼은 보이되, 질문 시 설정이 필요하다고 안내합니다.
# console.anthropic.com 에서 발급한 키를 넣으세요.
ANTHROPIC_API_KEY=

# 사용할 모델. 생략하면 claude-sonnet-4-5 를 사용합니다.
# CLAUDE_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# 알람 발송 (메신저 · 문자 · 메일)
# 연동 정보는 환경변수가 아니라 화면(설정 > 알림 발송)에서 입력해 DB 에 저장합니다.
# 워커(scripts/notify-worker.mjs)는 DATABASE_URL 만 있으면 됩니다.
# pm2 start deploy/ecosystem.config.js 로 웹과 워커가 함께 뜹니다.

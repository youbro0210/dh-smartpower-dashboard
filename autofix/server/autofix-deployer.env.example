# /etc/autofix-deployer.env — root 만 읽기(chmod 600). 배포기 설정
APP_URL=http://127.0.0.1:3000
AUTOFIX_SECRET=앱·GitHub 과 같은 값
APP_DIR=/var/www/dh-smartpower-dashboard
APP_USER=ubuntu
# 배포 키(읽기 전용, 저장소 › Settings › Deploy keys) — 키는 APP_USER 만 읽게
GIT_URL=git@github.com:youbro0210/dh-smartpower-dashboard.git
GIT_SSH_COMMAND="ssh -i /etc/autofix-deployer.key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/etc/autofix-deployer.known_hosts"
# 또는 읽기 전용 토큰(fine-grained PAT: Contents read): GIT_URL=https://x-access-token:토큰@github.com/youbro0210/dh-smartpower-dashboard.git
BRANCH=main
# 자동 수정은 GitHub 에서 검사를 통과했다 — 서버 타입검사는 건너뛴다(프로젝트 배포 스크립트가 받으면)
# 자동 수정은 db/·collector/·scripts/ 를 고치지 못하므로 스키마 반영과 수집기 재시작은 하지 않습니다.
BUILD_CMD="npm ci --no-audit --no-fund && npm run build"
RESTART_CMD="sudo -u ubuntu -H pm2 reload dh-dashboard --update-env"
HEALTH_URL=http://127.0.0.1:3000/login
